# Neon Postgres — pooled connection string (Neon dashboard → Connect → Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string. Used to salt the one-way IP hash that powers write rate limiting.
IP_SALT="change-me-to-a-long-random-string"
